      <children>
          <HBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0" prefWidth="200.0" styleClass="menu-container" stylesheets="@description.css" VBox.vgrow="ALWAYS">
              <children>
                  <Button fx:id="howToPlayBackBtn" mnemonicParsing="false" onAction="#onHowToPlayBackBtnClick" text="Back" HBox.hgrow="ALWAYS">
