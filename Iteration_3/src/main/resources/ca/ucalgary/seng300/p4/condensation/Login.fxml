<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="479.0" prefWidth="781.0" styleClass="pane-background" stylesheets="@loginstyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.LoginController">
   <children>
      <Pane layoutX="166.0" layoutY="102.0" prefHeight="280.0" prefWidth="447.0" styleClass="welcome-pane" stylesheets="@loginstyle.css">
