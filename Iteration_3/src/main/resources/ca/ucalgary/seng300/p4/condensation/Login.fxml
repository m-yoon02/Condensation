            <TextField fx:id="usernameField" layoutX="88.0" layoutY="66.0" onKeyTyped="#validateUser" prefHeight="34.0" prefWidth="275.0" promptText="Username Input" styleClass="input" stylesheets="@loginstyle.css" />
            <TextField fx:id="passwordField" layoutX="86.0" layoutY="132.0" onKeyTyped="#validatePass" prefHeight="34.0" prefWidth="275.0" promptText="Password Input" styleClass="input" stylesheets="@loginstyle.css" />
            <Button fx:id="loginBtn" layoutX="133.0" layoutY="195.0" mnemonicParsing="false" onMouseClicked="#continueToMain" prefHeight="34.0" prefWidth="181.0" stylesheets="@loginstyle.css" text="LOGIN" />
