<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.ProfileHomeController">
    <children>
        <TableView fx:id="playerTableView" layoutX="160.0" layoutY="135.0" prefHeight="142.0" prefWidth="528.0">
            <columns>
                <TableColumn fx:id="gameColumn" prefWidth="85.0" text="Game" />
                <TableColumn fx:id="currentEloColumn" prefWidth="94.4000244140625" text="Current Elo" />
                <TableColumn fx:id="totalWinsColumn" prefWidth="86.39996337890625" text="Total Wins" />
            </columns>
        </TableView>
        <TableView fx:id="playerRecentTableView" layoutX="160.0" layoutY="306.0" prefHeight="142.0" prefWidth="528.0">
            <columns>
                <TableColumn fx:id="playerRecentgameColumn" prefWidth="91.20001983642578" text="Game" />
                <TableColumn fx:id="playerRecentoutcomeColumn" prefWidth="95.199951171875" text="Outcome" />
                <TableColumn fx:id="playerRecentcurrentEloColumn" prefWidth="94.4000244140625" text="Current Elo" />
                <TableColumn fx:id="playerRecenttotalWinsColumn" prefWidth="104.800048828125" text="Total Wins" />
                <TableColumn fx:id="playerRecentgamesPlayedColumn" prefWidth="104.800048828125" text="Games Played" />
            </columns>
        </TableView>
        <Label layoutX="160.0" layoutY="109.0" text="Player Overall Stats" />
        <Label layoutX="160.0" layoutY="281.0" text="Player Recent Matches" />
        <Label fx:id="usernameField" layoutX="41.0" layoutY="55.0" text="PlayerOne" />
        <Button fx:id="leaderboardButton" layoutX="36.0" layoutY="162.0" onAction="#onLeaderboardButtonClicked" text="Leaderboard" />
        <Button fx:id="gamesButton" layoutX="36.0" layoutY="225.0" onAction="#onGamesButtonClicked" text="Games" />
        <Button fx:id="playerProfilesButton" layoutX="36.0" layoutY="289.0" onAction="#onPlayerProfilesButtonClicked" text="Player Lookup" />
        <Button fx:id="logoutButton" layoutX="36.0" layoutY="354.0" onAction="#onlogOutButtonClicked" text="Logout" />
    </children>
</AnchorPane>
