<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" styleClass="main-pane" stylesheets="@ProfileHome.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.ProfileHomeController">
    <children>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox prefHeight="70.0" prefWidth="200.0">
               <children>
                    <Label fx:id="usernameField" text="PlayerOne">
                     <font>
                        <Font size="26.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Label>
                  <Label fx:id="usernameField1" text="Profile Home">
                     <font>
                        <Font size="26.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="140.0" />
                     </HBox.margin>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="button-container" HBox.hgrow="NEVER">
                     <children>
                          <Button fx:id="leaderboardButton" onAction="#onLeaderboardButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Leaderboard">
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin></Button>
                          <Button fx:id="gamesButton" onAction="#onGamesButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Games">
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin></Button>
                          <Button fx:id="playerProfilesButton" onAction="#onPlayerProfilesButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Player Lookup">
                           <padding>
                              <Insets left="5.0" right="5.0" />
                           </padding>
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin></Button>
                        <Button fx:id="editUserButton" layoutX="28.0" layoutY="158.0" onAction="#onEditUserButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Edit Username">
                           <padding>
                              <Insets left="5.0" right="5.0" />
                           </padding>
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin>
                        </Button>
                        <Button fx:id="editPassButton" layoutX="28.0" layoutY="212.0" onAction="#onEditPassButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Edit Password">
                           <padding>
                              <Insets left="5.0" right="5.0" />
                           </padding>
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin>
                        </Button>
                          <Button fx:id="logoutButton" onAction="#onlogOutButtonClicked" prefHeight="39.0" prefWidth="114.0" text="Logout">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin></Button>
                     </children>
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                          <Label text="Player Overall Stats" textFill="#fcf7f7" />
                          <TableView fx:id="playerTableView" prefHeight="142.0" prefWidth="528.0">
                              <columns>
                                  <TableColumn fx:id="gameColumn" prefWidth="85.0" text="Game" />
                                  <TableColumn fx:id="currentEloColumn" prefWidth="94.4000244140625" text="Current Elo" />
                                  <TableColumn fx:id="totalWinsColumn" prefWidth="86.39996337890625" text="Total Wins" />
                              </columns>
                          </TableView>
                          <Label text="Player Recent Matches" textFill="WHITE">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin></Label>
                          <TableView fx:id="playerRecentTableView" prefHeight="142.0" prefWidth="528.0">
                              <columns>
                                  <TableColumn fx:id="playerRecentgameColumn" prefWidth="91.20001983642578" text="Game" />
                                  <TableColumn fx:id="playerRecentoutcomeColumn" prefWidth="95.199951171875" text="Outcome" />
                                  <TableColumn fx:id="playerRecentcurrentEloColumn" prefWidth="94.4000244140625" text="Current Elo" />
                                  <TableColumn fx:id="playerRecenttotalWinsColumn" prefWidth="104.800048828125" text="Total Wins" />
                                  <TableColumn fx:id="playerRecentgamesPlayedColumn" prefWidth="104.800048828125" text="Games Played" />
                              </columns>
                          </TableView>
                     </children>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
    </children>
</AnchorPane>
