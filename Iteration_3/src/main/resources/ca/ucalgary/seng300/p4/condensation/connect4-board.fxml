                                <Button fx:id="sendBtn" layoutX="203.0" mnemonicParsing="false" onAction="#onSendBtnClick" text="Send" />
                            </children>
                        </AnchorPane>
                    </children>
                </VBox>
                <GridPane fx:id="connectFourGrid" alignment="CENTER" hgap="5" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" vgap="5">
                    <!-- Rows -->
                    <GridPane>
                        <rowConstraints>
                            <RowConstraints percentHeight="16.67" />
                            <RowConstraints percentHeight="16.67" />
                            <RowConstraints percentHeight="16.67" />
                            <RowConstraints percentHeight="16.67" />
                            <RowConstraints percentHeight="16.67" />
                            <RowConstraints percentHeight="16.67" />
