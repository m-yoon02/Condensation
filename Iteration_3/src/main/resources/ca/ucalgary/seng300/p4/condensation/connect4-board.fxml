<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/22.0.1"
            fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.ConnectFourController" stylesheets="@connect4-board.css">

    <!-- Title -->
    <top>
        <Text text="Connect 4" styleClass="title-text" BorderPane.alignment="CENTER"/>
    </top>

    <!-- Game Board -->
    <center>
        <GridPane fx:id="connectFourGrid" alignment="CENTER" hgap="5" vgap="5" BorderPane.alignment="CENTER">
            <!-- Rows -->
            <GridPane>
                <rowConstraints>
                    <RowConstraints percentHeight="16.67"/>
                    <RowConstraints percentHeight="16.67"/>
                    <RowConstraints percentHeight="16.67"/>
                    <RowConstraints percentHeight="16.67"/>
                    <RowConstraints percentHeight="16.67"/>
                    <RowConstraints percentHeight="16.67"/>
                </rowConstraints>

                <!-- Columns -->

                <columnConstraints>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                    <ColumnConstraints percentWidth="14.29"/>
                </columnConstraints>
            </GridPane>

            <!-- Buttons for Connect 4 Slots -->
            <Button fx:id="btn00" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn01" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn02" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn03" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn04" GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn05" GridPane.rowIndex="0" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn06" GridPane.rowIndex="0" GridPane.columnIndex="6" styleClass="game-button"/>

            <Button fx:id="btn10" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn11" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn12" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn13" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn14" GridPane.rowIndex="1" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn15" GridPane.rowIndex="1" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn16" GridPane.rowIndex="1" GridPane.columnIndex="6" styleClass="game-button"/>

            <Button fx:id="btn20" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn21" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn22" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn23" GridPane.rowIndex="2" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn24" GridPane.rowIndex="2" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn25" GridPane.rowIndex="2" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn26" GridPane.rowIndex="2" GridPane.columnIndex="6" styleClass="game-button"/>

            <Button fx:id="btn30" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn31" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn32" GridPane.rowIndex="3" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn33" GridPane.rowIndex="3" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn34" GridPane.rowIndex="3" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn35" GridPane.rowIndex="3" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn36" GridPane.rowIndex="3" GridPane.columnIndex="6" styleClass="game-button"/>

            <Button fx:id="btn40" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn41" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn42" GridPane.rowIndex="4" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn43" GridPane.rowIndex="4" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn44" GridPane.rowIndex="4" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn45" GridPane.rowIndex="4" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn46" GridPane.rowIndex="4" GridPane.columnIndex="6" styleClass="game-button"/>

            <Button fx:id="btn50" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="game-button"/>
            <Button fx:id="btn51" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="game-button"/>
            <Button fx:id="btn52" GridPane.rowIndex="5" GridPane.columnIndex="2" styleClass="game-button"/>
            <Button fx:id="btn53" GridPane.rowIndex="5" GridPane.columnIndex="3" styleClass="game-button"/>
            <Button fx:id="btn54" GridPane.rowIndex="5" GridPane.columnIndex="4" styleClass="game-button"/>
            <Button fx:id="btn55" GridPane.rowIndex="5" GridPane.columnIndex="5" styleClass="game-button"/>
            <Button fx:id="btn56" GridPane.rowIndex="5" GridPane.columnIndex="6" styleClass="game-button"/>
        </GridPane>
    </center>
</BorderPane>
