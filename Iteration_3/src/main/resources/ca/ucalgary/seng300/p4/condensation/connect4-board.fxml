                            </content>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </ScrollPane>
                        <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" styleClass="chat-container">
