                <VBox alignment="CENTER" styleClass="chat-v-box" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="playerTurnText" text="Player 1's Turn" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                     <font>
                        <Font size="16.0" />
                     </font>
                        </Label>
                        <ScrollPane fx:id="chatScrollPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="247.0" styleClass="chat-scroll-pane" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="paneInsideScrollPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity">
                                    <children>
