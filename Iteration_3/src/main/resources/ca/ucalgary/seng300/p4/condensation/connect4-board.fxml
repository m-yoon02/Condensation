    <!-- Forfeit Button -->
    <bottom>
        <HBox alignment="CENTER">
            <children>
                <Button fx:id="forfeitBtn" alignment="CENTER" onAction="#onForfeitBtnClick" prefHeight="30.0" prefWidth="100.0" styleClass="forfeit-button" text="Forfeit" />
            </children>
        </HBox>
    </bottom>
    
</BorderPane>
