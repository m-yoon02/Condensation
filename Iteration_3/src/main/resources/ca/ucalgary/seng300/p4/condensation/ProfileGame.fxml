<AnchorPane prefHeight="500.0" prefWidth="700.0" styleClass="main-pane" stylesheets="@ProfileGame.css" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.ProfileGameController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#44539c" height="338.0" layoutX="3.0" layoutY="63.0" stroke="BLACK" strokeType="INSIDE" width="231.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#44539c" height="338.0" layoutX="467.0" layoutY="63.0" stroke="BLACK" strokeType="INSIDE" width="231.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#44539c" height="338.0" layoutX="235.0" layoutY="63.0" stroke="BLACK" strokeType="INSIDE" width="231.0" />
      <Label fx:id="Title" layoutX="313.0" layoutY="5.0" text="Games" textFill="#cfc9c9">
         <font>
            <Font name="Oswald Regular" size="22.0" />
         </font>
      </Label>
      <Button fx:id="ticTacToePlayButton" layoutX="95.0" layoutY="410.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="46.0" text="Play" />
      <Button fx:id="connect4PlayButton" layoutX="565.0" layoutY="410.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="46.0" text="Play" />
      <Button fx:id="checkersPlayButton" layoutX="329.0" layoutY="410.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="46.0" text="Play" />
      <Button fx:id="homeButton" layoutX="624.0" layoutY="453.0" mnemonicParsing="false" onAction="#onHomeButtonClicked" prefHeight="30.0" prefWidth="60.0" text="Home">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Label fx:id="ticTacToeArea" layoutX="61.0" layoutY="69.0" prefHeight="27.0" prefWidth="116.0" text="TIC TAC TOE" textFill="#ffffffb8">
