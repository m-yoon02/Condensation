            <Font name="Oswald Regular" size="15.0" />
         </font>
      </Label>
      <TextArea fx:id="tictactoeDes" layoutX="7.0" layoutY="100.0" prefHeight="295.0" prefWidth="223.0" text="Players take turns marking &#10;Xs and Os on a 3x3 grid.&#10;&#10;Goal:&#10;align three of your&#10;marks horizontally, vertically,&#10;or diagonally.&#10;" wrapText="true" />
      <TextArea fx:id="connect4Des" layoutX="239.0" layoutY="99.0" prefHeight="295.0" prefWidth="223.0" text="Players take turns dropping &#10;colored discs into a 7-column, 6-row grid. &#10;&#10;Goal:&#10;connect four discs in a row &#10;(horizontally, vertically, or&#10; diagonally).&#10;" wrapText="true" />
      <TextArea fx:id="checkersDes" layoutX="471.0" layoutY="100.0" prefHeight="295.0" prefWidth="223.0" text="Players  move their&#10;pieces diagonally on an &#10;8x8 board, aiming to capture &#10;all opponent pieces by &#10;jumping over them. &quot;King&quot; &#10;pieces gain additional &#10;movement capabilities &#10;when reaching the opposite &#10;end.&#10;&#10;Goal:&#10;Capture all the opponent &#10;pieces!" />
   </children>
</AnchorPane>
