            <Font name="Oswald Regular" size="18.0" />
         </font>
      </Label>
      <Label fx:id="connect4Area" layoutX="308.0" layoutY="69.0" text="CONNECT 4 " textFill="#0d0d0dbd">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="checkersArea" layoutX="544.0" layoutY="69.0" text="CHECKERS">
         <font>
            <Font size="18.0" />
