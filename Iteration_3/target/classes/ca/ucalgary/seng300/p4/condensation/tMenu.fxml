<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" styleClass="main-pane" stylesheets="@tMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.p4.condensation.Frontend.controller.tMenuController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0" prefWidth="200.0" styleClass="menu-container" VBox.vgrow="NEVER">
                    <children>
                        <Button fx:id="goBack" mnemonicParsing="false" onAction="#initialize" text="Back" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="3.0" left="15.0" top="3.0" />
                            </HBox.margin></Button>
                    </children>
                </HBox>
                <VBox prefHeight="200.0" prefWidth="100.0" styleClass="game-container" VBox.vgrow="ALWAYS">
                    <children>
                        <Label fx:id="nameLabel" text="TicTacToe" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button fx:id="playButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#initialize" stylesheets="@tMenu.css" text="Play" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Button>
                        <Button fx:id="leaderboardButton" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#initialize" text="View Leaderboard" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Button>
                        <Button fx:id="howToPlayButton" mnemonicParsing="false" onAction="#initialize" text="How To Play">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Button>
                        <ImageView fitHeight="135.0" fitWidth="140.0">
                            <image>
                                <Image url="@tictac.png" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
